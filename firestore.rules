rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidRecipe(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.slug is string && data.slug.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.category is string &&
             data.imageUrl is string &&
             data.likes is int &&
             data.featured is bool &&
             data.createdAt is int;
    }

    // Recipes: Anyone can read, anyone can upvote (likes), only admin can create/update fully/delete
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if isAdmin() && isValidRecipe(request.resource.data);
      allow update: if (isAdmin() && isValidRecipe(request.resource.data)) || 
                     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) && 
                      request.resource.data.likes == resource.data.likes + 1);
      allow delete: if isAdmin();
    }

    // Contact messages: anyone can create, only admin can read
    match /contacts/{contactId} {
      allow create: if request.resource.data.name is string && 
                      request.resource.data.email is string && 
                      request.resource.data.message is string;
      allow read: if isAdmin();
    }
  }
}
